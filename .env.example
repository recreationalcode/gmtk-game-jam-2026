# Copy to `.env` and fill in to enable the online leaderboard.
# Without these the game falls back to a local leaderboard in localStorage.
#
# Vite inlines VITE_* variables at BUILD time, so these must be set when you run
# `npm run package`, not when you upload.
#
# NOTE: the key ends up inside the client bundle and is extractable. Use a
# submit-scoped key if simpleboards.dev offers one. See docs/LEADERBOARD.md.

VITE_SIMPLEBOARDS_LEADERBOARD_ID=
VITE_SIMPLEBOARDS_API_KEY=

# Only needed if the service's base URL differs from the default.
# VITE_SIMPLEBOARDS_BASE_URL=https://api.simpleboards.dev
