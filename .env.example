# Leaderboard setup. The game is fully playable without any of this — with no
# configuration it keeps a local leaderboard in localStorage and says so on the
# score screen.
#
# Vite inlines VITE_* variables at BUILD time, so they must be set when you run
# `npm run package`, not when you upload.

# --- Recommended: proxy mode ------------------------------------------------
#
# Deploy `api/scores.ts` to Vercel, put the API key in the Vercel environment,
# and point the game at it. Nothing secret ends up in the bundle.
#
# This is the ONLY variable the game needs in proxy mode. It is a public URL.

VITE_LEADERBOARD_PROXY=https://your-project.vercel.app

# The key and board id go in the VERCEL project's environment, not here:
#
#   SIMPLEBOARDS_API_KEY         (secret)
#   SIMPLEBOARDS_LEADERBOARD_ID
#   SIMPLEBOARDS_BASE_URL        optional
#   LEADERBOARD_ALLOWED_ORIGINS  optional, comma-separated
#   LEADERBOARD_MAX_SCORE        optional
#
# See docs/LEADERBOARD.md.

# --- Fallback: direct mode --------------------------------------------------
#
# No server to deploy to? The game can talk to simpleboards.dev itself. The key
# then ships inside the client bundle and IS EXTRACTABLE by anyone who looks.
# Only use a submit-scoped key, and expect to moderate the board.
#
# Ignored when VITE_LEADERBOARD_PROXY is set.

# VITE_SIMPLEBOARDS_LEADERBOARD_ID=
# VITE_SIMPLEBOARDS_API_KEY=
# VITE_SIMPLEBOARDS_BASE_URL=https://api.simpleboards.dev
