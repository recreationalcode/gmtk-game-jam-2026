{
  "name": "pogo-drop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Pogo Drop \u2014 a first-person pogo-stick score attack for GMTK Game Jam 2026 (theme: Count Down)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:fast": "vite build",
    "build:vercel": "npm run build && node scripts/package-itch.mjs --out dist/pogo-drop-itch.zip",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && node scripts/package-itch.mjs",
    "art": "node scripts/page-art.mjs",
    "smoke": "node scripts/smoke.mjs",
    "diag": "node scripts/diag.mjs",
    "fullrun": "node scripts/fullrun.mjs",
    "transitions": "node scripts/transitions.mjs",
    "coach": "node scripts/coach.mjs",
    "leaderboard": "node scripts/leaderboard-ui.mjs",
    "proxy": "node scripts/proxy.mjs",
    "proxy:e2e": "node scripts/proxy-e2e.mjs",
    "touch": "node scripts/touch.mjs",
    "tiles": "node scripts/tiles.mjs",
    "music": "node scripts/music.mjs",
    "aim": "node scripts/aim.mjs"
  },
  "devDependencies": {
    "@types/three": "^0.185.1",
    "gifenc": "^1.0.3",
    "playwright": "^1.62.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.5"
  },
  "dependencies": {
    "three": "^0.185.1"
  }
}
